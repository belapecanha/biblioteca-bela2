{
  "name": "biblioteca-bela",
  "productName": "Biblioteca Bela",
  "version": "0.1.0",
  "description": "Catálogo pessoal de leitura",
  "main": "./out/main/index.js",
  "author": "Isabela",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:gerar": "drizzle-kit generate",
    "test": "node scripts/testar.mjs",
    "test:app": "npm run build && playwright test",
    "importar": "node scripts/importar.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
